{
  "name": "mirrorlab",
  "version": "0.1.0",
  "description": "Android and iPhone screen mirroring with audio, recording, AI-agent control and inspection tools.",
  "main": "dist/main/main.js",
  "type": "commonjs",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:airplay": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-airplay.ps1",
    "build:usb": "node scripts/build-usb.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "package:win": "npm run build && node scripts/package.mjs win32"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "electron": "^44.9.0",
    "esbuild": "^0.28.2",
    "fast-xml-parser": "^5.11.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "zod": "3.25"
  }
}
